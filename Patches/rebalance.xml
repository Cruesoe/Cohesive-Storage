	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>[sbz] Neat Storage</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationReplace">
					<success>Always</success>
					<xpath>Defs/ThingDef[@Name="sbzCrateBase"]/building/maxItemsInCell</xpath>
					<value>
						<maxItemsInCell>8</maxItemsInCell>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="sbz_MidCrate"]</xpath>
					<value>
						<building>
							<fixedStorageSettings>
								<filter>
									<disallowNotEverStorable>true</disallowNotEverStorable>
									<categories Inherit="False">
										<li>Root</li>
									</categories>
									<disallowedCategories Inherit="False">
										<li>Foods</li>
										<li>FoodMeals</li>
										<li>Corpses</li>
										<li>Chunks</li>
									</disallowedCategories>
								</filter>
							</fixedStorageSettings>
						</building>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="sbz_Safe"]/building/maxItemsInCell</xpath>
					<value>
						<maxItemsInCell>18</maxItemsInCell>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="sbz_Safe"]/statBases/MaxHitPoints</xpath>
					<value>
						<MaxHitPoints>5000</MaxHitPoints>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="sbz_Safe"]/costStuffCount</xpath>
					<value>
						<costStuffCount>200</costStuffCount>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="sbz_Safe"]/building/fixedStorageSettings/filter</xpath>
					<value>
						<filter>
							<disallowNotEverStorable>true</disallowNotEverStorable>
							<thingDefs>
								<li>Silver</li>
							</thingDefs>
						</filter>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="sbz_Safe"]/building/defaultStorageSettings/filter</xpath>
					<value>
						<filter>
							<disallowNotEverStorable>true</disallowNotEverStorable>
							<thingDefs>
								<li>Silver</li>
							</thingDefs>
						</filter>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="sbz_Drum"]/building/maxItemsInCell</xpath>
					<value>
						<maxItemsInCell>15</maxItemsInCell>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="sbz_Drum"]/building/fixedStorageSettings/filter</xpath>
					<value>
						<filter>
							<disallowNotEverStorable>true</disallowNotEverStorable>
							<categories Inherit="False">
								<li>ResourcesRaw</li>
								<li>Foods</li>
							</categories>
						</filter>
					</value>
				</li>
				<li Class="PatchOperationFindMod">
					<mods>
						<li>Vanilla Furniture Expanded</li>
					</mods>
					<match Class="PatchOperationReplace">
						<success>Always</success>
						<xpath>Defs/ThingDef[@Name="sbzWeaponRackBase"]/costStuffCount</xpath>
						<value>
							<costStuffCount>50</costStuffCount>
						</value>
					</match>
				</li>
			</operations>
		</match>
	</Operation>

	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>[sbz] Fridge</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationReplace">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="sbz_Fridge"]/building/maxItemsInCell</xpath>
					<value>
						<maxItemsInCell>6</maxItemsInCell>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<success>Always</success>
					<xpath>Defs/AdaptiveStorage.GraphicsDef[defName="sbz_FridgeASF"]/itemGraphics</xpath>
					<value>
						<itemGraphics>
							<columns>
								<c0>
									<rows>
										<r0>
											<stackBehaviour>Stack</stackBehaviour>
											<stackOffset>(0,-0.05,0.12)</stackOffset>
											<stackOffsetEast>(0,-0.02,0.08)</stackOffsetEast>
											<stackOffsetWest>(0,-0.02,0.08)</stackOffsetWest>
											<stackOffsetSouth>(0,0,0)</stackOffsetSouth>
											<drawOffset>(0,0.6,0.15)</drawOffset>
											<drawOffsetEast>(-0.1,0.1,0.15)</drawOffsetEast>
											<drawOffsetWest>(0.1,0.1,0.15)</drawOffsetWest>
											<drawOffsetSouth>(0,0,1000)</drawOffsetSouth>
											<drawScale>0.5</drawScale>
											<rotation>0</rotation>
										</r0>
									</rows>
								</c0>
							</columns>
						</itemGraphics>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="sbz_LargeFridge"]/building/maxItemsInCell</xpath>
					<value>
						<maxItemsInCell>6</maxItemsInCell>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="sbz_SingleChestFridge"]/building/maxItemsInCell</xpath>
					<value>
						<maxItemsInCell>6</maxItemsInCell>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="sbz_DoubleChestFridge"]/building/maxItemsInCell</xpath>
					<value>
						<maxItemsInCell>6</maxItemsInCell>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="sbz_SingleWallFridge"]/building/maxItemsInCell</xpath>
					<value>
						<maxItemsInCell>6</maxItemsInCell>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="sbz_DoubleWallFridge"]/building/maxItemsInCell</xpath>
					<value>
						<maxItemsInCell>6</maxItemsInCell>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="sbz_CorpseFridge"]/building/maxItemsInCell</xpath>
					<value>
						<maxItemsInCell>6</maxItemsInCell>
					</value>
				</li>
			</operations>
		</match>
	</Operation>

	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Vanilla Factions Expanded - Medieval 2</li>
		</mods>
		<match Class="PatchOperationReplace">
			<success>Always</success>
			<xpath>Defs/ThingDef[defName="VFEM2_AilmentsShelf"]/building/maxItemsInCell</xpath>
			<value>
				<maxItemsInCell>6</maxItemsInCell>
			</value>
		</match>
	</Operation>
</Patch>
