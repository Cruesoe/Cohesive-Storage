<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Neolithic: Adaptive large pot vs Phaneron pot. -->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Adaptive Storage Neolithic Module</li>
		</mods>
		<match Class="PatchOperationFindMod">
			<mods>
				<li>Phaneron's Basic Storage</li>
			</mods>
			<match Class="PatchOperationAdd">
				<success>Always</success>
				<xpath>Defs/ThingDef[@Name="ASNeolithicLargePotThingBase"]</xpath>
				<value>
					<designationCategory></designationCategory>
				</value>
			</match>
		</match>
	</Operation>

	<!-- Neolithic: Adaptive plinths vs Neat displays. -->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Adaptive Storage Neolithic Module</li>
		</mods>
		<match Class="PatchOperationFindMod">
			<mods>
				<li>[sbz] Neat Storage</li>
			</mods>
			<match Class="PatchOperationAdd">
				<success>Always</success>
				<xpath>Defs/ThingDef[@Name="ASNeolithicPlinthBase"]</xpath>
				<value>
					<designationCategory></designationCategory>
				</value>
			</match>
		</match>
	</Operation>

	<!-- Phaneron internal: large crate and large bundle vs pallets. -->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Phaneron's Basic Storage</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAdd">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="BasicStorageLargeCrate"]</xpath>
					<value>
						<designationCategory></designationCategory>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="BasicStorageLargeBundle"]</xpath>
					<value>
						<designationCategory></designationCategory>
					</value>
				</li>
			</operations>
		</match>
	</Operation>

	<!-- Neat internal: tall crate and extra display skins. -->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>[sbz] Neat Storage</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAdd">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="sbz_CorpseSpot"]</xpath>
					<value>
						<designationCategory></designationCategory>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="sbz_TallCrate"]</xpath>
					<value>
						<designationCategory></designationCategory>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="sbz_OpenShelf"]</xpath>
					<value>
						<designationCategory></designationCategory>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="sbz_TallDisplayShelf"]</xpath>
					<value>
						<designationCategory></designationCategory>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="sbz_NarrowTallDisplayShelf"]</xpath>
					<value>
						<designationCategory></designationCategory>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="sbz_DisplayCabinet"]</xpath>
					<value>
						<designationCategory></designationCategory>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="sbz_NarrowDisplayCabinet"]</xpath>
					<value>
						<designationCategory></designationCategory>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="sbz_RoundPedestal"]</xpath>
					<value>
						<designationCategory></designationCategory>
					</value>
				</li>
			</operations>
		</match>
	</Operation>

	<!-- Phaneron + Neat: keep Phaneron crates, pallets, and weapon rack; keep Neat meat hook. -->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Phaneron's Basic Storage</li>
		</mods>
		<match Class="PatchOperationFindMod">
			<mods>
				<li>[sbz] Neat Storage</li>
			</mods>
			<match Class="PatchOperationSequence">
				<operations>
					<li Class="PatchOperationAdd">
						<success>Always</success>
						<xpath>Defs/ThingDef[defName="sbz_SmallCrate"]</xpath>
						<value>
							<designationCategory></designationCategory>
						</value>
					</li>
					<li Class="PatchOperationAdd">
						<success>Always</success>
						<xpath>Defs/ThingDef[defName="sbz_Pallet"]</xpath>
						<value>
							<designationCategory></designationCategory>
						</value>
					</li>
					<li Class="PatchOperationAdd">
						<success>Always</success>
						<xpath>Defs/ThingDef[defName="sbz_MiniPallet"]</xpath>
						<value>
							<designationCategory></designationCategory>
						</value>
					</li>
					<li Class="PatchOperationAdd">
						<success>Always</success>
						<xpath>Defs/ThingDef[defName="sbz_HalfPallet"]</xpath>
						<value>
							<designationCategory></designationCategory>
						</value>
					</li>
					<li Class="PatchOperationAdd">
						<success>Always</success>
						<xpath>Defs/ThingDef[defName="sbz_WeaponRack"]</xpath>
						<value>
							<designationCategory></designationCategory>
						</value>
					</li>
					<li Class="PatchOperationAdd">
						<success>Always</success>
						<xpath>Defs/ThingDef[defName="sbz_HorizontalWeaponRack"]</xpath>
						<value>
							<designationCategory></designationCategory>
						</value>
					</li>
					<li Class="PatchOperationAdd">
						<success>Always</success>
						<xpath>Defs/ThingDef[defName="sbz_VerticalWeaponRack"]</xpath>
						<value>
							<designationCategory></designationCategory>
						</value>
					</li>
					<li Class="PatchOperationAdd">
						<success>Always</success>
						<xpath>Defs/ThingDef[defName="BasicStorageMeatHook"]</xpath>
						<value>
							<designationCategory></designationCategory>
						</value>
					</li>
				</operations>
			</match>
		</match>
	</Operation>
</Patch>
