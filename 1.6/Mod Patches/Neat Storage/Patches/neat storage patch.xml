<?xml version="1.0" encoding="utf-8"?>
<Patch>


    <!-- GETTING RID OF STUFF -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="sbz_CorpseSpot"]</xpath>
        <value>
            <designationCategory></designationCategory>
        </value>
    </Operation>


    <!-- PHANERON: drop overlapping Neat pallets -->
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Phaneron's Basic Storage</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="sbz_Pallet"]</xpath>
                    <value>
                        <designationCategory></designationCategory>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="sbz_MiniPallet"]</xpath>
                    <value>
                        <designationCategory></designationCategory>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="sbz_HalfPallet"]</xpath>
                    <value>
                        <designationCategory></designationCategory>
                    </value>
                </li>
            </operations>
        </match>
    </Operation>


    <!-- RELABEL -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="sbz_Crate"]/label</xpath>
        <value>
            <label>large container</label>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="sbz_MidCrate"]/label</xpath>
        <value>
            <label>medium container</label>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="sbz_SmallCrate"]/label</xpath>
        <value>
            <label>small container</label>
        </value>
    </Operation>


    <!-- VE FURNITURE -->
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Furniture Expanded</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="Shelf_WeaponRack"]/label</xpath>
                    <value>
                        <label>small weapon rack</label>
                    </value>
                </li>
                <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[@Name="sbzWeaponRackBase"]/costStuffCount</xpath>
                    <value>
                        <costStuffCount>50</costStuffCount>
                    </value>
                </li>
            </operations>
        </match>
    </Operation>

</Patch>