<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>Defs/ThingDef[@Name="sbzGravshipCrateBase"]/researchPrerequisites</xpath>
		<value>
			<researchPrerequisites>
				<li>Cohesive_SpacerStorage</li>
			</researchPrerequisites>
